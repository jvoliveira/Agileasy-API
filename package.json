{
  "name": "webservicenest-servicos",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_ENV=production nest build",
    "build:dev": "cross-env NODE_ENV=development nest build",
    "get:sql": "git archive --remote='git@gitlab.com:v1pi/webservicenest-servicos/snippets/2021646.git' master | tar -x -C ./",
    "up:postgres": "npm run get:sql && docker-compose -f docker-compose-local.yml up -d",
    "format": "npx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env NODE_ENV=development nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=test nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint": "npx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest",
    "test:watch": "npx jest --watch",
    "test:cov": "npx jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npx jest --config ./test/jest-e2e.json",
    "deploy:dev": "npm run get:sql && npm run build:dev && rsync -avz -e 'ssh -p 22' --exclude='.vscode' --exclude='.git' --exclude='src' --exclude='node_modules' --exclude='test' . 34.95.206.131:/home/delivery/deploy_dev && rm -f *.sql"
  },
  "dependencies": {
    "@aginix/nestjs-firebase-admin": "^2.0.1",
    "@hapi/joi": "^17.1.1",
    "@nestjs/common": "^7.0.0",
    "@nestjs/config": "^0.5.0",
    "@nestjs/core": "^7.0.0",
    "@nestjs/platform-express": "^7.0.0",
    "@nestjs/typeorm": "^7.1.4",
    "cache-manager": "^3.4.0",
    "class-transformer": "^0.3.1",
    "class-validator": "^0.12.2",
    "cross-env": "^7.0.2",
    "firebase-admin": "^9.2.0",
    "moment-timezone": "^0.5.31",
    "pg": "^8.3.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.5.4",
    "typeorm": "^0.2.26"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.11",
    "@golevelup/nestjs-testing": "^0.1.2",
    "@nestjs/cli": "^7.0.0",
    "@nestjs/schematics": "^7.0.0",
    "@nestjs/testing": "^7.0.0",
    "@types/express": "^4.17.3",
    "@types/hapi__joi": "^17.1.4",
    "@types/jest": "26.0.10",
    "@types/node": "^13.9.1",
    "@types/pg": "^7.14.5",
    "@types/supertest": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "4.4.0",
    "@typescript-eslint/parser": "4.4.0",
    "eslint": "7.11.0",
    "eslint-config-prettier": "^6.12.0",
    "eslint-plugin-import": "^2.22.1",
    "jest": "26.4.2",
    "prettier": "^1.19.1",
    "supertest": "^4.0.2",
    "ts-jest": "26.2.0",
    "ts-loader": "^6.2.1",
    "ts-node": "9.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "isolatedModules": true
      }
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 5000,
    "testPathIgnorePatterns": [
      "<rootDir>/build/",
      "<rootDir>/dist/",
      "<rootDir>/node_modules/"
    ]
  }
}
